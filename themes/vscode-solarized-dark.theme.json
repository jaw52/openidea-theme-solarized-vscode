// Solarized Dark (VS Code): UI theme. Colours follow the Solarized Dark theme bundled with VS Code
// (microsoft/vscode, extensions/theme-solarized-dark); tokens VS Code leaves to its base theme use that base's value.
// Keys are the CSS variables of OpenIDEA's src/styles/tokens.css. Comments are allowed (// and /* */).
{
  "id": "vscode-solarized-dark",
  "name": "Solarized Dark (VS Code)",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#002b36",
    "--bg-elev": "#003847",
    "--bg-popup": "#00212b",
    "--bg-floating-toolbar": "#00212b",
    "--bg-hover": "#004454aa",
    "--bg-selected": "#005a6f",
    "--bg-selected-strong": "#00687f",
    "--bg-current-line": "#073642",
    "--bg-debug-line": "#0d4e53",
    "--bg-backdrop": "#00212b",
    "--bg-input": "#003847",

    // Lines
    "--border": "#003847",
    "--border-popup": "#004052",
    "--border-strong": "#586e7566",
    "--border-window": "#586e7566",
    "--control-off": "#586e75",

    // Text
    "--fg-strong": "#fdf6e3",
    "--fg-emphasis": "#eee8d5",
    "--fg": "#93a1a1",
    "--fg-secondary": "#839496",
    "--fg-muted": "#839496",
    "--fg-subtle": "#586e75",
    "--fg-faint": "#425d65",
    "--fg-gutter": "#858585",
    "--fg-icon": "#93a1a1",

    // Accent
    "--accent": "#2aa198",
    "--link": "#268bd2",
    "--link-hover": "#5ca6d6",

    // Charts
    "--chart-series": "#cb4b16",

    // Status
    "--danger": "#dc322f",
    "--warning": "#b58900",
    "--success": "#859900",
    "--db-connected": "#859900",
    "--db-connected-ring": "#43621b",
    "--info": "#268bd2",

    // Vcs
    "--vcs-modified": "#e2c08d",
    "--vcs-added": "#81b88b",
    "--vcs-deleted": "#c74e39",
    "--vcs-untracked": "#73c991",
    "--vcs-ignored": "#8c8c8c",
    "--vcs-conflict": "#e4676b",
    "--gutter-modified": "#1b81a8",
    "--gutter-added": "#487e02",
    "--gutter-deleted": "#e51400",
    "--diff-modified": "#084058",
    "--diff-inserted": "#1d432a",
    "--diff-deleted": "#302d34",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.45)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.6), 0 10px 24px rgba(0, 0, 0, 0.35), 0 24px 72px rgba(0, 0, 0, 0.45)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#586e75",
    "--traffic-off-border": "#35535c",

    // Additive
    "--bg-tooltip": "#004052",
    "--fg-tooltip": "#eee8d5",
    "--border-tooltip": "#004052",
    "--bg-control": "#00212b",
    "--bg-control-hover": "#004454",
    "--bg-active": "#004052",
    "--bg-scrim": "rgba(0, 0, 0, 0.45)",
    "--fg-on-accent": "#fdf6e3",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.45)",

    // Islands contract
    "--bg-frame": "#00212b",
    "--bg-island": "#002b36",
    "--bg-stripe-hover": "#93a1a11a",
    "--bg-stripe-selected": "#93a1a12e",
    "--fg-stripe-selected-active": "#ffffff",
    "--fg-stripe-label": "#839496",
    "--bg-tab-selected": "#002b37",
    "--border-tab-selected": "#2aa198",
    "--bg-tab-selected-inactive": "#004052",
    "--border-tab-selected-inactive": "#00445488",
    "--bg-tab-hover": "#93a1a11a",
    "--border-editor-tabs": "#003847",
    "--bg-tree-selected": "#005a6f",
    "--bg-tree-selected-inactive": "#00445488",
    "--bg-tree-hover": "#93a1a112",
    "--bg-toolbar-hover": "#93a1a11a",
    "--bg-toolbar-pressed": "#93a1a12e",
    "--bg-toolbar-selected": "#005a6f",
    "--bg-toolbar-selected-hover": "#00657b",
    "--bg-button-primary-hover": "#4aaea3",
    "--fg-button-primary": "#fdf6e3",
    "--bg-button": "transparent",
    "--border-button": "#586e7566",
    "--bg-field": "#003847",
    "--bg-checkbox": "#003847",
    "--border-checkbox": "#586e75",
    "--bg-toggle-on": "#859900",
    "--fg-toggle-on": "#fdf6e3",
    "--bg-toggle-off": "#003847",
    "--fg-toggle-off": "#586e75",
    "--border-toggle": "#586e75",
    "--bg-toggle-knob": "#586e75",
    "--focus-ring-soft": "#2aa19899",
    "--scrollbar-thumb": "#79797966",
    "--scrollbar-thumb-hover": "#646464b3",
    "--bg-search-match": "#ea5c0055",
    "--bg-search-match-current": "#515c6a",
    "--fg-search-match": "#eee8d5",
    "--bg-dialog": "#002b36",
    "--bg-popup-inline": "#00212b",
    "--bg-popup-advertiser": "#00212b",
    "--bg-feedback-info": "#052730",
    "--border-feedback-info": "#363b5f",
    "--bg-feedback-error": "#571b26",
    "--border-feedback-error": "#a92049",
    "--bg-feedback-warning": "#5d5938",
    "--border-feedback-warning": "#9d8a5e",
    "--bg-feedback-success": "#1b412b",
    "--border-feedback-success": "#496818",
    "--bg-counter": "#047aa6",
    "--fg-counter": "#fdf6e3",
    "--bg-progress-track": "#004052"
  }
}
