// Solarized Dark (VS Code): editor colour scheme (syntax, editor surfaces, ANSI colours), from the VS Code theme's tokenColors and colors.
{
  "name": "Solarized Dark (VS Code)",
  "tokens": {
    // Syntax
    "--syn-keyword": "#859900",
    "--syn-string": "#2aa198",
    "--syn-type": "#cb4b16",
    "--syn-function": "#268bd2",
    "--syn-function-call": "#268bd2",
    "--syn-comment": "#586e75",
    "--syn-comment-style": "italic",
    "--syn-doc-comment": "#586e75",
    "--syn-docstring": "#2aa198",
    "--syn-annotation": "#b58900",
    "--syn-decorator": "#b58900",
    "--syn-number": "#d33682",
    "--syn-punct": "#839496",
    "--syn-variable": "#268bd2",
    "--syn-global": "var(--syn-variable)",
    "--syn-param": "#839496",
    "--syn-property": "#268bd2",
    "--syn-constant": "#b58900",
    "--syn-builtin": "#268bd2",
    "--syn-self": "#268bd2",
    "--syn-keyword-arg": "#839496",
    "--syn-predefined": "#839496",
    "--syn-escape": "#cb4b16",
    "--syn-regexp": "#dc322f",
    "--syn-tag": "#268bd2",
    "--syn-attribute": "#93a1a1",
    "--syn-todo": "#d33682",
    "--syn-link": "#268bd2",
    "--syn-markup-heading": "#268bd2",
    "--syn-markup-code": "#2aa198",
    "--syn-invalid": "#dc322f",
    "--syn-inline-value": "#586e75",
    "--syn-rainbow-1": "#6c71c4",
    "--syn-rainbow-2": "#2aa198",
    "--syn-rainbow-3": "#b58900",
    "--syn-rainbow-4": "#d33682",
    "--syn-rainbow-5": "#268bd2",
    "--syn-bracket-1": "#cdcdcd",
    "--syn-bracket-2": "#b58900",
    "--syn-bracket-3": "#d33682",

    // Editor
    "--fg-editor": "#839496",
    "--caret": "#d30102",
    "--fg-line-number": "#858585",
    "--fg-line-number-current": "#949494",
    "--border-gutter": "#00212b",
    "--border-indent-guide": "#93a1a180",
    "--border-indent-guide-active": "#c3e1e180",
    "--border-right-margin": "#93a1a140",
    "--bg-editor-selection": "#274642",
    "--bg-editor-selection-inactive": "#14393c",
    "--bg-text-search-result": "#ea5c0055",
    "--bg-text-search-result-current": "#515c6a",
    "--bg-matched-brace": "#0064001a",
    "--matched-brace-weight": "inherit",
    "--bg-matched-tag": "#0064001a",
    "--bg-fold-placeholder": "#93a1a124",
    "--fg-fold-placeholder": "#839496",
    "--fg-fold-marker": "#586e75",
    "--fg-whitespace": "#93a1a180",
    "--fg-unused": "#586e75",
    "--bg-identifier-under-caret": "#004454aa",
    "--bg-identifier-under-caret-write": "#005a6faa",
    "--fg-inlay": "#839496",
    "--bg-inlay": "#93a1a11f",
    "--wave-error": "#f14c4c",
    "--wave-warning": "#cca700",
    "--editor-error-decoration": "underline wavy #f14c4c",
    "--editor-warning-decoration": "underline wavy #cca700",
    "--editor-warning-background": "transparent",
    "--bg-breakpoint-line": "#302d34",
    "--fg-completion-match": "#1ebcc5",
    "--bg-editor-inline": "#073642",
    "--bg-editor-banner": "#052730",
    "--fg-weak-warning": "#586e75",
    "--fg-bulb": "#b58900",

    // ANSI palette
    "--ansi-black": "#073642",
    "--ansi-red": "#dc322f",
    "--ansi-green": "#859900",
    "--ansi-yellow": "#b58900",
    "--ansi-blue": "#268bd2",
    "--ansi-magenta": "#d33682",
    "--ansi-cyan": "#2aa198",
    "--ansi-white": "#eee8d5",
    "--ansi-bright-black": "#002b36",
    "--ansi-bright-red": "#cb4b16",
    "--ansi-bright-green": "#586e75",
    "--ansi-bright-yellow": "#657b83",
    "--ansi-bright-blue": "#839496",
    "--ansi-bright-magenta": "#6c71c4",
    "--ansi-bright-cyan": "#93a1a1",
    "--ansi-bright-white": "#fdf6e3",

    // Terminal ANSI palette
    "--terminal-ansi-black": "#073642",
    "--terminal-ansi-red": "#dc322f",
    "--terminal-ansi-green": "#859900",
    "--terminal-ansi-yellow": "#b58900",
    "--terminal-ansi-blue": "#268bd2",
    "--terminal-ansi-magenta": "#d33682",
    "--terminal-ansi-cyan": "#2aa198",
    "--terminal-ansi-white": "#eee8d5",
    "--terminal-ansi-bright-black": "#002b36",
    "--terminal-ansi-bright-red": "#cb4b16",
    "--terminal-ansi-bright-green": "#586e75",
    "--terminal-ansi-bright-yellow": "#657b83",
    "--terminal-ansi-bright-blue": "#839496",
    "--terminal-ansi-bright-magenta": "#6c71c4",
    "--terminal-ansi-bright-cyan": "#93a1a1",
    "--terminal-ansi-bright-white": "#fdf6e3"
  }
}
