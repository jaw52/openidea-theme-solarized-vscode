// Solarized Light (VS Code): editor colour scheme (syntax, editor surfaces, ANSI colours), from the VS Code theme's tokenColors and colors.
{
  "name": "Solarized Light (VS Code)",
  "tokens": {
    // Syntax
    "--syn-keyword": "#859900",
    "--syn-string": "#2aa198",
    "--syn-type": "#cb4b16",
    "--syn-function": "#268bd2",
    "--syn-function-call": "#268bd2",
    "--syn-comment": "#93a1a1",
    "--syn-comment-style": "italic",
    "--syn-doc-comment": "#93a1a1",
    "--syn-docstring": "#2aa198",
    "--syn-annotation": "#b58900",
    "--syn-decorator": "#b58900",
    "--syn-number": "#d33682",
    "--syn-punct": "#657b83",
    "--syn-variable": "#268bd2",
    "--syn-global": "var(--syn-variable)",
    "--syn-param": "#657b83",
    "--syn-property": "#268bd2",
    "--syn-constant": "#b58900",
    "--syn-builtin": "#268bd2",
    "--syn-self": "#268bd2",
    "--syn-keyword-arg": "#657b83",
    "--syn-predefined": "#657b83",
    "--syn-escape": "#cb4b16",
    "--syn-regexp": "#dc322f",
    "--syn-tag": "#268bd2",
    "--syn-attribute": "#93a1a1",
    "--syn-todo": "#d33682",
    "--syn-link": "#268bd2",
    "--syn-markup-heading": "#268bd2",
    "--syn-markup-code": "#2aa198",
    "--syn-invalid": "#dc322f",
    "--syn-inline-value": "#93a1a1",
    "--syn-rainbow-1": "#6c71c4",
    "--syn-rainbow-2": "#2aa198",
    "--syn-rainbow-3": "#b58900",
    "--syn-rainbow-4": "#d33682",
    "--syn-rainbow-5": "#268bd2",
    "--syn-bracket-1": "#586e75",
    "--syn-bracket-2": "#b58900",
    "--syn-bracket-3": "#d33682",

    // Editor
    "--fg-editor": "#657b83",
    "--caret": "#657b83",
    "--fg-line-number": "#237893",
    "--fg-line-number-current": "#567983",
    "--border-gutter": "#ddd6c1",
    "--border-indent-guide": "#586e7580",
    "--border-indent-guide-active": "#081e2580",
    "--border-right-margin": "#586e7540",
    "--bg-editor-selection": "#eee8d5",
    "--bg-editor-selection-inactive": "#f6efdc",
    "--bg-text-search-result": "#ea5c0055",
    "--bg-text-search-result-current": "#a8ac94",
    "--bg-matched-brace": "#0064001a",
    "--matched-brace-weight": "inherit",
    "--bg-matched-tag": "#0064001a",
    "--bg-fold-placeholder": "#586e7524",
    "--fg-fold-placeholder": "#657b83",
    "--fg-fold-marker": "#93a1a1",
    "--fg-whitespace": "#586e7580",
    "--fg-unused": "#93a1a1",
    "--bg-identifier-under-caret": "#57575740",
    "--bg-identifier-under-caret-write": "#0e639c40",
    "--fg-inlay": "#93a1a1",
    "--bg-inlay": "#586e751f",
    "--wave-error": "#e51400",
    "--wave-warning": "#bf8803",
    "--editor-error-decoration": "underline wavy #e51400",
    "--editor-warning-decoration": "underline wavy #bf8803",
    "--editor-warning-background": "transparent",
    "--bg-breakpoint-line": "#f8dbca",
    "--fg-completion-match": "#b58900",
    "--bg-editor-inline": "#eee8d5",
    "--bg-editor-banner": "#e3e9e1",
    "--fg-weak-warning": "#93a1a1",
    "--fg-bulb": "#b58900",

    // ANSI palette
    "--ansi-black": "#073642",
    "--ansi-red": "#dc322f",
    "--ansi-green": "#859900",
    "--ansi-yellow": "#b58900",
    "--ansi-blue": "#268bd2",
    "--ansi-magenta": "#d33682",
    "--ansi-cyan": "#2aa198",
    "--ansi-white": "#eee8d5",
    "--ansi-bright-black": "#002b36",
    "--ansi-bright-red": "#cb4b16",
    "--ansi-bright-green": "#586e75",
    "--ansi-bright-yellow": "#657b83",
    "--ansi-bright-blue": "#839496",
    "--ansi-bright-magenta": "#6c71c4",
    "--ansi-bright-cyan": "#93a1a1",
    "--ansi-bright-white": "#fdf6e3",

    // Terminal ANSI palette
    "--terminal-ansi-black": "#073642",
    "--terminal-ansi-red": "#dc322f",
    "--terminal-ansi-green": "#859900",
    "--terminal-ansi-yellow": "#b58900",
    "--terminal-ansi-blue": "#268bd2",
    "--terminal-ansi-magenta": "#d33682",
    "--terminal-ansi-cyan": "#2aa198",
    "--terminal-ansi-white": "#eee8d5",
    "--terminal-ansi-bright-black": "#002b36",
    "--terminal-ansi-bright-red": "#cb4b16",
    "--terminal-ansi-bright-green": "#586e75",
    "--terminal-ansi-bright-yellow": "#657b83",
    "--terminal-ansi-bright-blue": "#839496",
    "--terminal-ansi-bright-magenta": "#6c71c4",
    "--terminal-ansi-bright-cyan": "#93a1a1",
    "--terminal-ansi-bright-white": "#fdf6e3"
  }
}
