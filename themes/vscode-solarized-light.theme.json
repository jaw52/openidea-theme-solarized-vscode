// Solarized Light (VS Code): UI theme. Colours follow the Solarized Light theme bundled with VS Code
// (microsoft/vscode, extensions/theme-solarized-light); tokens VS Code leaves to its base theme use that base's value.
// Keys are the CSS variables of OpenIDEA's src/styles/tokens.css. Comments are allowed (// and /* */).
{
  "id": "vscode-solarized-light",
  "name": "Solarized Light (VS Code)",
  "kind": "light",
  "tokens": {
    // Surfaces
    "--bg-app": "#fdf6e3",
    "--bg-elev": "#eee8d5",
    "--bg-popup": "#eee8d5",
    "--bg-floating-toolbar": "#eee8d5",
    "--bg-hover": "#dfca8844",
    "--bg-selected": "#dfca88",
    "--bg-selected-strong": "#d7be70",
    "--bg-current-line": "#eee8d5",
    "--bg-debug-line": "#e7d59f",
    "--bg-backdrop": "#eee8d5",
    "--bg-input": "#ddd6c1",

    // Lines
    "--border": "#ddd6c1",
    "--border-popup": "#d3af86",
    "--border-strong": "#ccc4b0",
    "--border-window": "#ccc4b0",
    "--control-off": "#93a1a1",

    // Text
    "--fg-strong": "#002b36",
    "--fg-emphasis": "#073642",
    "--fg": "#586e75",
    "--fg-secondary": "#657b83",
    "--fg-muted": "#839496",
    "--fg-subtle": "#93a1a1",
    "--fg-faint": "#b8bfb8",
    "--fg-gutter": "#237893",
    "--fg-icon": "#586e75",

    // Accent
    "--accent": "#b58900",
    "--link": "#268bd2",
    "--link-hover": "#1d73ab",

    // Charts
    "--chart-series": "#cb4b16",

    // Status
    "--danger": "#dc322f",
    "--warning": "#b58900",
    "--success": "#859900",
    "--db-connected": "#859900",
    "--db-connected-ring": "#c1c872",
    "--info": "#268bd2",

    // Vcs
    "--vcs-modified": "#895503",
    "--vcs-added": "#587c0c",
    "--vcs-deleted": "#ad0707",
    "--vcs-untracked": "#007100",
    "--vcs-ignored": "#8e8e90",
    "--vcs-conflict": "#6c6cc4",
    "--gutter-modified": "#2090d3",
    "--gutter-added": "#48985d",
    "--gutter-deleted": "#e51400",
    "--diff-modified": "#dbe5e0",
    "--diff-inserted": "#eae7bf",
    "--diff-deleted": "#f8d7c6",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(7, 54, 66, 0.18)",
    "--shadow-dialog": "0 0 0 0.5px rgba(7, 54, 66, 0.2), 0 10px 24px rgba(7, 54, 66, 0.12), 0 24px 72px rgba(7, 54, 66, 0.22)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#d3cbb7",
    "--traffic-off-border": "#c4bca8",

    // Additive
    "--bg-tooltip": "#ccc4b0",
    "--fg-tooltip": "#073642",
    "--border-tooltip": "#ccc4b0",
    "--bg-control": "#eee8d5",
    "--bg-control-hover": "#e7d9af",
    "--bg-active": "#ddd6c1",
    "--bg-scrim": "rgba(7, 54, 66, 0.2)",
    "--fg-on-accent": "#fdf6e3",
    "--shadow-tooltip": "0 4px 12px rgba(7, 54, 66, 0.16)",
    "--shadow-balloon": "0 8px 24px rgba(7, 54, 66, 0.18)",

    // Islands contract
    "--bg-frame": "#eee8d5",
    "--bg-island": "#fdf6e3",
    "--bg-stripe-hover": "#0736421a",
    "--bg-stripe-selected": "#0736422e",
    "--fg-stripe-selected-active": "#ffffff",
    "--fg-stripe-label": "#657b83",
    "--bg-tab-selected": "#fdf6e3",
    "--border-tab-selected": "#b58900",
    "--bg-tab-selected-inactive": "#d3cbb7",
    "--border-tab-selected-inactive": "#ddd6c1",
    "--bg-tab-hover": "#0736421a",
    "--border-editor-tabs": "#ddd6c1",
    "--bg-tree-selected": "#dfca88",
    "--bg-tree-selected-inactive": "#d1cbb8",
    "--bg-tree-hover": "#07364212",
    "--bg-toolbar-hover": "#0736421a",
    "--bg-toolbar-pressed": "#0736422e",
    "--bg-toolbar-selected": "#dfca88",
    "--bg-toolbar-selected-hover": "#d9c074",
    "--bg-button-primary-hover": "#9a7b08",
    "--fg-button-primary": "#fdf6e3",
    "--bg-button": "#eee8d5",
    "--border-button": "#ccc4b0",
    "--bg-field": "#ddd6c1",
    "--bg-checkbox": "#ddd6c1",
    "--border-checkbox": "#93a1a1",
    "--bg-toggle-on": "#859900",
    "--fg-toggle-on": "#fdf6e3",
    "--bg-toggle-off": "#ddd6c1",
    "--fg-toggle-off": "#93a1a1",
    "--border-toggle": "#93a1a1",
    "--bg-toggle-knob": "#93a1a1",
    "--focus-ring-soft": "#b49471",
    "--scrollbar-thumb": "#64646466",
    "--scrollbar-thumb-hover": "#646464b3",
    "--bg-search-match": "#ea5c0055",
    "--bg-search-match-current": "#a8ac94",
    "--fg-search-match": "#073642",
    "--bg-dialog": "#fdf6e3",
    "--bg-popup-inline": "#eee8d5",
    "--bg-popup-advertiser": "#eee8d5",
    "--bg-feedback-info": "#e3e9e1",
    "--border-feedback-info": "#9cc6db",
    "--bg-feedback-error": "#f9decd",
    "--border-feedback-error": "#ee9e92",
    "--bg-feedback-warning": "#f1e5bf",
    "--border-feedback-warning": "#d9c072",
    "--bg-feedback-success": "#ece9c3",
    "--border-feedback-success": "#c1c872",
    "--bg-counter": "#b58900",
    "--fg-counter": "#fdf6e3",
    "--bg-progress-track": "#ddd6c1"
  }
}
